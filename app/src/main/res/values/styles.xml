<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thin Font -->
    <style name="ClockTimeThin">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">09:41</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">52sp</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Light Font -->
    <style name="ClockTimeLight">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">09:41</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">52sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Regular Font -->
    <style name="ClockTimeRegular">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">09:41</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">52sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Medium Font -->
    <style name="ClockTimeMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">09:41</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">52sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Bold Font -->
    <style name="ClockTimeBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">09:41</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">52sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Main App Theme -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF3333</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
    </style>

</resources>
